# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# X Layer wallet (used for settlement + faucet signing)
SETTLEMENT_PRIVATE_KEY=0x...

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_CONTACT_URL=https://your-contact-or-booking-page.example
ADMIN_SECRET=your-admin-secret-key
# Use separate, randomly generated secrets in production (32+ bytes each).
PILOT_ACCESS_KEY=your-campaign-creation-key
CLAIM_TOKEN_SECRET=your-claim-token-signing-secret
SECURITY_CONTACT=mailto:security@your-domain.example
RECEIPTS_PUBLIC=false
ENABLE_TESTNET_FAUCET=false
AUTO_ACCEPT=false
REQUIRE_WALLET_SIGNATURE=true
ALLOW_OPERATOR_FUNDED_CAMPAIGNS=false

# OKX x402 payment config
OKX_PAYMENT_TOKEN=0x74b7F16337b8972027F6196A17a631aC6dE26d22
OKX_PAYMENT_NETWORK=196
OKX_FACILITATOR_URL=https://www.okx.com/web3/build/ai
# Public x402 v2 facilitator for canonical Base mainnet USDC.
BASE_X402_FACILITATOR_URL=https://facilitator.openx402.ai
ASP_PRICE_USDT=2.00
ASP_FEE_BPS=1200

# On-chain x402 verification (defaults match the X Layer testnet demo).
# Payments are proven by reading the ERC-20 Transfer log of the claimed tx:
# the token must be X402_VERIFY_TOKEN, sent to X402_VERIFY_RECIPIENT, amount >= price.
X402_VERIFY_RPC=https://testrpc.xlayer.tech
X402_VERIFY_CHAIN_ID=1952
X402_VERIFY_TOKEN=0x725cCe0916d2E8682438732fD9e79803B4fAB2BD
X402_VERIFY_RECIPIENT=0x430172985b21458d73576435D4aD4bEeA85F376C

# Groq (for task planning)
GROQ_API_KEY=your-groq-api-key
